---
// One redacted phrase per screen. Real text stays in the DOM; the bar is decorative.
// `auto` declassifies once after the entrance; click / Enter toggles afterwards.
interface Props { auto?: boolean; delay?: number }
const { auto = true, delay = 1350 } = Astro.props;
---
<button type="button" class="redacted" data-auto={auto ? 'true' : 'false'} data-delay={delay}
        aria-label="Reveal hidden word" aria-pressed="false"><slot /><span class="bar" aria-hidden="true"></span></button>

<style>
  .redacted {
    all: unset; position: relative; display: inline-block; cursor: pointer; color: inherit;
  }
  .redacted:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; }
  .bar {
    position: absolute; left: -0.04em; right: -0.04em; top: 0.08em; bottom: 0.06em; background: var(--redact);
    transform-origin: right center; transition: transform 420ms var(--ease-in-out);
  }
  .redacted[aria-pressed='true'] .bar { transform: scaleX(0); }
  @media (prefers-reduced-motion: reduce) { .bar { transition: opacity 200ms ease; } .redacted[aria-pressed='true'] .bar { transform: none; opacity: 0; } }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const entered = document.documentElement.hasAttribute('data-entered');
  document.querySelectorAll<HTMLButtonElement>('.redacted').forEach((el) => {
    const set = (open: boolean) => {
      el.setAttribute('aria-pressed', String(open));
      el.setAttribute('aria-label', open ? 'Hide word again' : 'Reveal hidden word');
    };
    if (el.dataset.auto === 'true') {
      if (reduce || entered) set(true);
      else setTimeout(() => set(true), Number(el.dataset.delay || 1350));
    }
    el.addEventListener('click', () => set(el.getAttribute('aria-pressed') !== 'true'));
  });
</script>
