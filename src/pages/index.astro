---
import BaseLayout from '../layouts/BaseLayout.astro';
import FolderTabs from '../components/FolderTabs.astro';
import Folder from '../components/Folder.astro';
import Button from '../components/Button.astro';
import Stamp from '../components/Stamp.astro';
import Redacted from '../components/Redacted.astro';
import Exhibit from '../components/Exhibit.astro';
import CaseFolder from '../components/CaseFolder.astro';
import TeamBoard from '../components/TeamBoard.astro';
import PastEvents from '../components/PastEvents.astro';
import TearOffSlips from '../components/TearOffSlips.astro';
import Footer from '../components/Footer.astro';
import { site, events, crews, heads, img, href } from '../data/site';
---
<BaseLayout>
  <FolderTabs current="Home" />
  <main id="main">

    <!-- 1 · Hero -->
    <Folder spread class="hero" label="TeamCodeLocked">
      <div slot="left" class="hero-left">
        <h1 class="display">
          <span class="enter" style="--t:200ms">Team</span>
          <span class="enter" style="--t:300ms"><Redacted>CodeLocked</Redacted></span>
        </h1>
        <p class="lede enter" style="--t:420ms;--d:10px">The tech club of BMS College of Engineering, Bengaluru.</p>
        <div class="actions enter" style="--t:500ms;--d:8px">
          <Button href={href('/join')}>Join the club</Button>
          <Button variant="secondary" href="#cases">See events</Button>
        </div>
      </div>
      <div slot="right" class="hero-right">
        <div class="enter-drop" style="--t:260ms">
          <Exhibit src={img('events/utsav-2026-group.webp')} alt="TeamCodeLocked members at Mind Snap, Utsav 2026" tagTitle="Mind Snap" tagLine="Utsav 2026" eager />
        </div>
        <div class="peek">
          {events.map((e, i) => (
            <div class="enter" style={`--t:${640 + i * 70}ms;--d:60px`}>
              <CaseFolder mini no={e.no} dateLabel={e.dateLabel} title={e.title} href="#cases" color={e.color} status={e.status} />
            </div>
          ))}
        </div>
      </div>
    </Folder>

    <!-- 2 · What we do -->
    <Folder id="about" label="What we do">
      <div class="about">
        <h2 class="h2">What we do</h2>
        <div class="about-grid scatter">
          <a class="block big link-block scatter-item" style="--sx:-14vw;--sy:10vh;--sr:-4deg;--land:40%" href={href('/events')}>
            <div class="posters">
              {events.map((e, i) => <img class="scatter-item" style={`--sx:${(i - 1) * 8}vw;--sy:-6vh;--sr:${(i - 1) * 9}deg;--land:${44 + i * 4}%`} src={e.poster} alt="" loading="lazy" decoding="async" />)}
            </div>
            <h3>Events</h3>
            <p>Escape rooms, a Jenga mystery and memory hunts at Utsav. <span class="go">See events →</span></p>
          </a>
          <a class="block link-block scatter-item" style="--sx:-10vw;--sy:18vh;--sr:5deg;--land:48%" href={site.bitbybit} target="_blank" rel="noopener">
            <code class="mark" aria-hidden="true">while (true) solve();</code>
            <h3>BitByBit</h3>
            <p>Our own coding platform, with weekly contests. <span class="go">Open BitByBit ↗</span><span class="sr-only"> (opens in a new tab)</span></p>
          </a>
          <a class="block link-block scatter-item" style="--sx:12vw;--sy:18vh;--sr:-5deg;--land:52%" href={href('/team')}>
            <div class="faces" aria-hidden="true">
              {heads.filter((h) => h.photo).slice(0, 5).map((h) => <img src={h.photo} alt="" loading="lazy" decoding="async" />)}
            </div>
            <h3>The team</h3>
            <p>The students who build, design and run it all. <span class="go">Meet them →</span></p>
          </a>
        </div>
      </div>
    </Folder>

    <!-- 3 · Past events (slides sideways) -->
    <PastEvents />

    <!-- 4 · BitByBit -->
    <Folder spread label="BitByBit" class="bbb">
      <div slot="left" class="bbb-left scatter">
        <h2 class="h2 scatter-item" style="--sx:-10vw;--sy:4vh;--land:40%">BitByBit</h2>
        <p class="lede">The club’s own competitive-coding platform for BMSCE.</p>
        <Button href={site.bitbybit} external>Open BitByBit</Button>
      </div>
      <div slot="right" class="bbb-right">
        <div class="screen" role="img" aria-label="What BitByBit offers: daily code sprint, contest arena, AI code coach, clans and duels, certificates">
          <div class="screen-bar"><span></span><span></span><span></span><b>bitbybit</b></div>
          <ul class="screen-list scatter">
            <li class="scatter-item" style="--sx:12vw;--sy:0vh;--land:43%"><i class="dot t"></i>Daily Code Sprint</li>
            <li class="scatter-item" style="--sx:16vw;--sy:0vh;--land:48%"><i class="dot o"></i>Contest Arena <em>live leaderboard</em></li>
            <li class="scatter-item" style="--sx:20vw;--sy:0vh;--land:53%"><i class="dot r"></i>AI Code Coach <em>hints, not answers</em></li>
            <li class="scatter-item" style="--sx:24vw;--sy:0vh;--land:58%"><i class="dot t"></i>Clans &amp; Duels</li>
            <li class="scatter-item" style="--sx:28vw;--sy:0vh;--land:63%"><i class="dot o"></i>Verified certificates</li>
          </ul>
        </div>
      </div>
    </Folder>

    <!-- 5 · People -->
    <Folder label="The team" class="spill">
      <div class="sec-head">
        <h2 class="h2">The 2026–27 team</h2>
        <Button variant="secondary" href={href('/team')}>Meet everyone</Button>
      </div>
      <TeamBoard animated />
    </Folder>

    <!-- 6 · Join -->
    <Folder spread label="Join" id="join">
      <div slot="left" class="join-left">
        <h2 class="h2">Join a crew</h2>
        <ul class="crew-list">{crews.map((c) => <li>{c}</li>)}</ul>
        <div class="join-status">
          {site.registrationsOpen
            ? <Button href={href('/join')}>Apply now</Button>
            : <><Stamp>Applications closed</Stamp><Button variant="secondary" href={site.instagram} external>Follow for updates</Button></>}
        </div>
      </div>
      <div slot="right" class="join-right">
        <TearOffSlips title="Take a slip" note="Tap one to copy or open it." slips={[
          { label: 'Email', value: site.email },
          { label: 'Instagram', value: '@teamcodelocked', href: site.instagram },
          { label: 'LinkedIn', value: 'TeamCodeLocked', href: site.linkedin },
          { label: 'BitByBit', value: 'BitByBit', href: site.bitbybit },
        ]} />
      </div>
    </Folder>
  </main>
  <Footer />
</BaseLayout>

<style>
  main { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(48px, 8vw, 112px); }
  .display { font: 900 clamp(3rem, 7.4vw, 7.25rem)/0.86 var(--font-display); font-variation-settings: "wdth" var(--display-wdth); text-transform: uppercase; letter-spacing: 0.005em; }
  .display > span { display: block; }
  .h2 { font: 900 clamp(2.25rem, 4.6vw, 4.25rem)/0.9 var(--font-display); font-variation-settings: "wdth" 72; text-transform: uppercase; }
  .h2.on-desk { color: var(--on-desk); }
  .lede { font-size: var(--t-body-l); line-height: 1.5; color: var(--text-soft); max-width: 34ch; }
  .sec-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--s-4); margin-bottom: var(--s-7); }

  /* hero */
  :global(.hero) { min-height: calc(100dvh - 56px - var(--desk-margin)); }
  :global(.hero > .page) { display: flex; flex-direction: column; }
  .hero-left { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: var(--s-6); padding: var(--s-5) 0; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4) var(--s-6); margin-top: clamp(32px, 7vh, 96px); }
  .hero-right { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: var(--s-8); padding-top: var(--s-5); }
  .peek { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 0 calc(-1 * clamp(28px, 4.5vw, 64px)) calc(-1 * clamp(28px, 4.5vw, 64px)); padding: 0 clamp(28px, 4.5vw, 64px); overflow: hidden; }

  /* about */
  .about .h2 { margin-bottom: var(--s-7); }
  .about-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: var(--s-5); }
  .block { background: var(--folder-2); border: 1px solid var(--line); border-radius: var(--r-folder); padding: var(--s-6); display: flex; flex-direction: column; gap: var(--s-2); min-width: 0; }
  .block h3 { font: 900 1.75rem/1 var(--font-display); font-variation-settings: "wdth" 72; text-transform: uppercase; margin-top: auto; padding-top: var(--s-5); }
  .block p { color: var(--text-soft); }
  .posters { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .posters img { width: 100%; aspect-ratio: 1115 / 902; object-fit: cover; background: #fff; padding: 4px; box-shadow: var(--shadow-rest); }
  .mark { font: 500 0.9375rem/1.4 var(--font-code); color: var(--teal); background: var(--desk); border: 1px solid var(--desk-line); border-radius: 6px; padding: 12px 14px; }
  .link-block { color: inherit; text-decoration: none; transition: border-color var(--dur-hover) var(--ease-out), transform var(--dur-ui) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .link-block:hover { border-color: var(--text-soft); transform: translateY(-2px); } .link-block:hover .go { color: var(--text); } }
  .link-block:active { transform: scale(0.985); }
  .go { color: var(--teal); font-weight: 600; white-space: nowrap; }
  .faces { display: flex; }
  .faces img { flex: none; width: 60px; height: 60px; object-fit: cover; border: 3px solid #fff; box-shadow: var(--shadow-rest); }
  .faces img + img { margin-left: -14px; }


  /* bitbybit */
  .bbb-left { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: var(--s-6); height: 100%; }
  .bbb-right { display: grid; align-content: center; height: 100%; }
  .screen { background: var(--desk); border: 1px solid var(--desk-line); border-radius: 10px; overflow: hidden; box-shadow: var(--shadow-raised); }
  .screen-bar { display: flex; align-items: center; gap: 6px; padding: 12px 14px; border-bottom: 1px solid var(--desk-line); }
  .screen-bar span { width: 10px; height: 10px; border-radius: 50%; background: var(--desk-line); }
  .screen-bar b { margin-left: auto; font: 600 0.8125rem/1 var(--font-code); color: var(--on-desk-soft); }
  .screen-list { list-style: none; padding: 8px 0; margin: 0; }
  .screen-list li { display: flex; align-items: center; gap: 12px; padding: 14px 18px; color: var(--on-desk); font: 500 1rem/1.3 var(--font-code); border-bottom: 1px solid var(--desk-line); }
  .screen-list li:last-child { border-bottom: 0; }
  .screen-list em { margin-left: auto; font-style: normal; font-size: 0.8125rem; color: var(--on-desk-soft); }
  .dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .dot.t { background: var(--teal); } .dot.o { background: var(--case-ms); } .dot.r { background: #ff7a6b; }


  /* join */
  .join-left { display: flex; flex-direction: column; gap: var(--s-6); }
  .crew-list { list-style: none; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .crew-list li { padding: 14px 0; border-bottom: 1px solid var(--line); font: 800 1.375rem/1 var(--font-display); font-variation-settings: "wdth" 80; text-transform: uppercase; }
  .join-status { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-5); }
  .join-right { display: grid; align-content: center; height: 100%; padding-top: var(--s-5); }

  @media (max-width: 1100px) {
    .about-grid { grid-template-columns: 1fr 1fr; }
    .block.big { grid-column: 1 / -1; }
  }
  @media (max-width: 860px) {
    :global(.hero) { min-height: 0; }
    .peek { display: none; }
    .hero-right { padding-bottom: var(--s-5); }
  }
  @media (max-width: 560px) {
    .about-grid { grid-template-columns: 1fr; }
  }
</style>
