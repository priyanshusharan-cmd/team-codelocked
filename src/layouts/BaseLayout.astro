---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/700.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import '../styles/page.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'TeamCodeLocked is the tech club of B.M.S. College of Engineering, Bengaluru: puzzle events at Utsav, BitByBit coding contests, and the people who run them.',
  noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title ? `${title} · TeamCodeLocked` : 'TeamCodeLocked · BMSCE tech club';
---
<!doctype html>
<html lang="en" style={`--grain:url(${base}/brand/grain.svg)`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e1a2e" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>
      // Always open at the top of the page (don't restore an old scroll spot or a #section)
      try { history.scrollRestoration = 'manual'; } catch (e) {}
      if (location.hash && !sessionStorage.getItem('tcld_nav')) { history.replaceState(null, '', location.pathname + location.search); }
      addEventListener('load', () => { if (!location.hash) scrollTo(0, 0); try { sessionStorage.setItem('tcld_nav', '1'); } catch (e) {} });
      // Entrance animations play once per session; afterwards pages render settled.
      try {
        if (sessionStorage.getItem('tcld_opened')) document.documentElement.dataset.entered = '';
        else addEventListener('load', () => sessionStorage.setItem('tcld_opened', '1'));
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
